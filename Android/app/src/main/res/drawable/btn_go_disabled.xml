<?xml version="1.0" encoding="utf-8"?>
<!-- Flat and unlit: reads as "not yet" rather than as a key you may press. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/arena_key" />
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="@color/arena_key_stroke" />
</shape>
