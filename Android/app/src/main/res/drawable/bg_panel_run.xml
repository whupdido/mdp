<?xml version="1.0" encoding="utf-8"?>
<!-- The run panel sits above the rest and should read that way: same panel
     fill, one step brighter at the edge so it holds the eye during a run. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/arena_panel_edge" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/arena_panel_raised" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/arena_go_dim" />
        </shape>
    </item>
</layer-list>
