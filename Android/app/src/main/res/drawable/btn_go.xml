<?xml version="1.0" encoding="utf-8"?>
<!-- The Task 1 start key. Same raised-cap construction as btn_accent, in go
     green, and larger: during a run it is the only control anyone may touch. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/arena_go_press" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/arena_go" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/arena_go_lit" />
        </shape>
    </item>
</layer-list>
