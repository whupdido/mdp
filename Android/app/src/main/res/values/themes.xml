<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AndroidApp" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/arena_accent</item>
        <item name="colorPrimaryVariant">@color/arena_accent_press</item>
        <item name="colorOnPrimary">@color/arena_on_accent</item>
        <item name="colorSecondary">@color/arena_robot</item>
        <item name="colorSecondaryVariant">@color/arena_robot</item>
        <item name="colorOnSecondary">@color/arena_on_accent</item>
        <item name="android:colorBackground">@color/arena_ground</item>
        <item name="colorSurface">@color/arena_panel</item>
        <item name="colorOnSurface">@color/arena_text</item>
        <item name="android:textColorPrimary">@color/arena_text</item>
        <item name="android:textColorSecondary">@color/arena_text_muted</item>
        <item name="android:statusBarColor">@color/arena_ground</item>
        <item name="android:navigationBarColor">@color/arena_ground</item>
        <item name="android:windowBackground">@color/arena_ground</item>
    </style>

    <style name="Theme.AndroidApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--
      Section caption. Wide tracking and small caps is the convention on real
      instrument fascias, and it separates a label from a value at a glance
      without needing a heavier weight or a rule.
    -->
    <style name="Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/arena_text_faint</item>
        <item name="android:drawableStart">@drawable/caption_tick</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Any number that can change. Tabular so digits do not jitter. -->
    <style name="Readout">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/arena_text_muted</item>
    </style>

    <!--
      Key caps. MaterialButton's own background is replaced by a layer-list so
      the top edge can be lit and the pressed state can visibly sink; that is
      what makes them feel like hardware rather than painted rectangles.
    -->
    <style name="PadButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btn_pad_selector</item>
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">@color/arena_ripple</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/arena_text</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="PadButton.Accent">
        <item name="android:background">@drawable/btn_accent_selector</item>
        <item name="android:textColor">@color/arena_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/arena_ripple_dark</item>
    </style>

    <style name="PadButton.Danger">
        <item name="android:background">@drawable/btn_danger_selector</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="rippleColor">@color/arena_ripple</item>
    </style>
</resources>
