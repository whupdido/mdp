<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Mission control.

      One rule runs through the whole palette and makes the screen readable at a
      glance during a timed run:

          AMBER  = something you did or can do
          CYAN   = something the robot is telling you
          RED    = a target
          GREEN  = the link is healthy

      Nothing else is allowed to be saturated. Everything structural is a cool
      near-black so the four signal colours are the only things that carry.
    -->

    <!-- Ground and surfaces -->
    <color name="arena_ground">#FF080C10</color>
    <color name="arena_panel">#FF131A21</color>
    <color name="arena_panel_raised">#FF1B242D</color>
    <color name="arena_hairline">#FF24303A</color>
    <color name="arena_hairline_soft">#FF1A242C</color>

    <!-- Type -->
    <color name="arena_text">#FFE6EDF2</color>
    <color name="arena_text_muted">#FF8A9AA6</color>
    <color name="arena_text_faint">#FF5C6B77</color>

    <!-- Your intent -->
    <color name="arena_accent">#FFF0A82E</color>
    <color name="arena_accent_dim">#FF8A6420</color>
    <color name="arena_accent_press">#FFC8891F</color>
    <color name="arena_on_accent">#FF0C1116</color>

    <!-- Robot telemetry -->
    <color name="arena_robot">#FF3FA8DE</color>
    <color name="arena_robot_bright">#FF7FD4FF</color>

    <!-- Targets and state -->
    <color name="arena_target">#FFFF5A3C</color>
    <color name="arena_ok">#FF4ECB8F</color>
    <color name="arena_bad">#FFE0785A</color>

    <!-- Key caps: a lit top edge over a darker base, so buttons read as hardware -->
    <color name="arena_key">#FF232E37</color>
    <color name="arena_key_edge">#FF0E141A</color>
    <color name="arena_key_stroke">#FF33424E</color>
    <color name="arena_panel_edge">#FF090E13</color>

    <color name="arena_danger">#FFC4553A</color>
    <color name="arena_danger_press">#FF7E3524</color>
    <color name="arena_danger_lit">#FFE0785A</color>
    <color name="arena_accent_lit">#FFFFC864</color>

    <color name="arena_ripple">#33FFFFFF</color>
    <color name="arena_ripple_dark">#33000000</color>

    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
</resources>
