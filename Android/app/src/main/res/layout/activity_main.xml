<?xml version="1.0" encoding="utf-8"?>
<!--
  One screen, landscape, tablet-first. The arena takes as much room as it can
  and stays square; everything Peter's half needs sits in a fixed column beside
  it. No drawer and no tabs: during a timed run nobody should have to navigate.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arena_ground"
    android:orientation="horizontal"
    android:padding="10dp"
    tools:context=".MainActivity">

    <!-- ============================ ARENA ============================ -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.example.androidapp.arena.ArenaView
            android:id="@+id/arena"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/arena_description" />

        <TextView
            android:id="@+id/hoverChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="@color/arena_accent"
            android:textSize="12sp"
            android:visibility="invisible"
            tools:text="(12, 15)  ·  120,150 cm"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/robotChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="@color/arena_robot"
            android:textSize="12sp"
            tools:text="ROBOT (1, 1) N" />

        <!--
          Replay scrubber. Sits over the arena rather than stealing a slot in
          the side column, and only exists while a replay is open.
        -->
        <LinearLayout
            android:id="@+id/replayBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="26dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplayPlay"
                style="@style/PadButton.Accent"
                android:layout_width="42dp"
                android:layout_height="32dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:text="@string/replay_play" />

            <SeekBar
                android:id="@+id/replaySeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:progressTint="@color/arena_accent"
                android:thumbTint="@color/arena_accent" />

            <TextView
                android:id="@+id/replayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:minWidth="58dp"
                android:textAlignment="center"
                android:textColor="@color/arena_text_muted"
                android:textSize="11sp"
                tools:text="12/48" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplayClose"
                style="@style/PadButton"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:text="@string/replay_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/replayNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/arena_target"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Target 11 (1) at obstacle 2"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- =========================== SIDE PANEL ========================= -->
    <!--
      ========================= RUN =========================
      Its own column, in the space the arena cannot use: the arena draws
      itself square and the screen is wider than it is tall, so this costs
      the map nothing.

      It earns the column. During an assessed run this is the only control
      anyone may touch and the only readout that matters, and the tablet is
      put down on a table afterwards for the supervisor to read from a
      distance, so the clock is large, the button is large, and nothing else
      competes with them.
    -->
    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_panel_run"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_run"
            style="@style/Caption" />

        <!--
          Which run START drives. Task 1 gets six minutes and a map keyed in
          beforehand; Task 2 gets three and an empty map, because its
          obstacles are only placed after the preparation time.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTask1"
                style="@style/PadButton.Accent"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:letterSpacing="0.08"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/task_1"
                android:textSize="11sp" />

            <Space android:layout_width="1dp" android:layout_height="5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTask2"
                style="@style/PadButton"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:letterSpacing="0.08"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/task_2"
                android:textSize="11sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
          Counts DOWN. What matters is how much budget is left, and it has to
          stay legible across a table. Sized so a blown budget (-0:12, five
          glyphs) still fits the column rather than clipping.
        -->
        <TextView
            android:id="@+id/runCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/arena_text_muted"
            android:textSize="34sp"
            tools:text="4:12" />

        <TextView
            android:id="@+id/runBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="@color/arena_text_faint"
            android:textSize="10sp"
            tools:text="of 6:00 left" />

        <!-- Identified / placed: what the supervisor is scoring in Task 1. -->
        <LinearLayout
            android:id="@+id/tallyRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@null"
                android:text="@string/run_images"
                style="@style/Caption" />

            <TextView
                android:id="@+id/runTally"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/arena_text"
                android:textSize="20sp"
                tools:text="3 / 5" />
        </LinearLayout>

        <!-- Pushes START to the bottom, where a thumb reaches it. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Says why START is refused, so nobody presses a dead button. -->
        <TextView
            android:id="@+id/runHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/run_idle_hint"
            android:textColor="@color/arena_text_faint"
            android:textSize="10sp"
            tools:text="No image face set on B3." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/PadButton.Go"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/run_start" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="332dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <!-- ====================== Robot link, C.1/C.2/C.8 ====================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_link"
                    style="@style/Caption" />

                <!--
                  Run clock. Task 1 times out at 6 min and the fastest-car run
                  at 3, so during an attempt this is the number anyone actually
                  wants on screen. Starts itself on the robot's first move.
                -->
                <TextView
                    android:id="@+id/runClock"
                    style="@style/Readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:textColor="@color/arena_accent"
                    android:textSize="13sp"
                    tools:text="02:41" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/arena_text_faint" />

                <TextView
                    android:id="@+id/linkStateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/arena_text"
                    android:textSize="13sp"
                    tools:text="Connected to raspberrypi" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    style="@style/PadButton.Accent"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/connect" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisconnect"
                    style="@style/PadButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/disconnect" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSimulator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="36dp"
                android:text="@string/simulator_mode"
                android:textColor="@color/arena_text_muted"
                android:textSize="12sp"
                android:thumbTint="@color/switch_thumb"
                android:trackTint="@color/switch_track" />
        </LinearLayout>

        <!--
          Status and Traffic share this one slot rather than stacking. The Tab
          A7 Lite only gives the side column about 600dp, and the fixed panels
          above and below already claim most of it — showing both text panels
          at once left each with no room for any text at all.
        -->
        <!-- ====================== Status box, C.4 ====================== -->
        <LinearLayout
            android:id="@+id/statusPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:minHeight="90dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_status"
                style="@style/Caption" />

            <ScrollView
                android:id="@+id/statusScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/statusBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/arena_text"
                    android:textSize="12sp"
                    tools:text="10:02:11  Connected to raspberrypi." />
            </ScrollView>
        </LinearLayout>

        <!-- ====================== Traffic drawer ====================== -->
        <!--
          Shares the flexible space with the status box rather than taking a
          fixed height. On the Tab A7 Lite the side column only has about
          600dp to work with, and a fixed drawer pushed the drive pad off the
          bottom the moment it opened.
        -->
        <LinearLayout
            android:id="@+id/trafficPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="90dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_debug"
                style="@style/Caption" />

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:minHeight="56dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/logBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/arena_text_muted"
                    android:textSize="11sp"
                    tools:text="10:02:14  RX  ROBOT,7,2,W" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/injectField"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:autofillHints="off"
                    android:background="@drawable/bg_field"
                    android:fontFamily="monospace"
                    android:hint="@string/inject_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/arena_text"
                    android:textColorHint="@color/arena_text_faint"
                    android:textSize="11sp" />

                <Space android:layout_width="6dp" android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInject"
                    style="@style/PadButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/inject" />
            </LinearLayout>
        </LinearLayout>

        <!--
          ====================== Drive pad, C.3 ======================
          Hidden while a run is going. The rules forbid touching anything but
          the start button during an attempt, so these are not merely useless
          then - a stray tap on Forward would put a command on the wire in the
          middle of a planned route. The space goes to the status box, which
          is what the supervisor is reading.
        -->
        <LinearLayout
            android:id="@+id/drivePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_drive"
                    style="@style/Caption" />

                <TextView
                    android:id="@+id/stepReadout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/arena_text_muted"
                    android:textSize="11sp"
                    tools:text="10 cm · 90°" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDriveMode"
                    style="@style/PadButton"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:textSize="10sp"
                    android:text="@string/mode_pad" />
            </LinearLayout>

            <!--
              The gesture control for C.3. Buttons remain the default because
              that is what the checklist was signed on; this is the faster one
              to use, and the checklist notes gestures score better.
            -->
            <com.example.androidapp.control.GesturePad
                android:id="@+id/gesturePad"
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/pad_description"
                android:visibility="gone"
                tools:visibility="visible" />


            <LinearLayout
                android:id="@+id/buttonGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFwdLeft"
                        style="@style/PadButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/drive_fwd_left" />
    
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnForward"
                        style="@style/PadButton.Accent"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/drive_forward" />
    
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFwdRight"
                        style="@style/PadButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/drive_fwd_right" />
                </LinearLayout>
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">
    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackLeft"
                        style="@style/PadButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/drive_back_left" />
    
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackward"
                        style="@style/PadButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/drive_back" />
    
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackRight"
                        style="@style/PadButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/drive_back_right" />
                </LinearLayout>
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">
    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDistDown"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        style="@style/PadButton"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:maxLines="1"
                        android:text="−" />
    
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDistUp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        style="@style/PadButton"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:maxLines="1"
                        android:text="+" />
    
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        style="@style/PadButton.Danger"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/drive_stop" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>

        <!-- ====================== Map actions ====================== -->
        <!-- Also hidden during a run: clearing the map mid-attempt would
             throw away the layout the supervisor watched being keyed in. -->
        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndo"
                style="@style/PadButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:textSize="11sp"
                android:text="@string/undo" />

            <Space android:layout_width="6dp" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/PadButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:textSize="11sp"
                android:text="@string/clear" />

            <Space android:layout_width="6dp" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDemo"
                style="@style/PadButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:textSize="11sp"
                android:text="@string/demo_layout" />

            <Space android:layout_width="6dp" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplay"
                style="@style/PadButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:text="@string/replay_open" />

